# Yvoke — environment template. Copy to `.env` and fill in the blanks.
#
#   cp .env.example .env
#
# `.env` is git-ignored and holds real credentials; this file is committed and must never.
# All three Compose services (postgres, db-migration, app) declare `env_file: .env`, so every
# variable below reaches whichever container consumes it.
#
# Only the variables that CANNOT work as shipped are uncommented. Everything else has a working
# default in `src/main/resources/application.yml`, which stays the single source of defaults —
# the commented block at the end is a menu, not a requirement.
#
# `EnvExampleContractTest` pins this file against application.yml in both directions: a variable
# here that nothing reads fails the build, and so does a setting whose shipped default is a
# `placeholder-…` that this file forgets to mention.

# ── Database ─────────────────────────────────────────────────────────────────────────────────
# Consumed by the postgres image, the Flyway migration container and the app. The hostname is the
# Compose service name; use localhost:5433 only when running the app outside Compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

FLYWAY_URL=jdbc:postgresql://postgres:5432/postgres
FLYWAY_USER=postgres
FLYWAY_PASSWORD=
FLYWAY_CONNECT_RETRIES=60

# ── Secrets at rest ──────────────────────────────────────────────────────────────────────────
# SecretCipher encrypts stored connector credentials with these. Running without APP_SECRET_KEY is
# permitted ONLY under a dev/local/test profile (Compose sets SPRING_PROFILES_ACTIVE=local); any
# real deployment fails to start without it.
APP_SECRET_KEY=
APP_SECRET_SALT=

# ── Authentication ───────────────────────────────────────────────────────────────────────────
# APP_SECURITY_MOCK=true bypasses Entra sign-in and is likewise refused outside a dev profile.
# Leave the ENTRA_* values blank while mocking.
APP_SECURITY_MOCK=true
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Static key for the machine-to-machine ingest/document/job routes. The shipped default
# `dev-key-12345` is refused by SecurityConfig, which leaves that whole filter chain uninstalled —
# so a blank here is not the same as a working key.
APP_SECURITY_API_KEY=

# ── Models and providers ─────────────────────────────────────────────────────────────────────
# AI_PROVIDER is the DEFAULT route, used for any model AI_MODEL_ROUTES does not map.
# One of: gemini, azure-openai-responses.
AI_PROVIDER=gemini

# Per-model overrides, as a JSON object. Blank or {} sends every model to AI_PROVIDER.
# Declaring a route CONSTRUCTS its client at startup, so an azure-openai-responses entry requires
# AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_API_KEY in the same file — without them the app does not
# degrade, it fails to start naming the missing setting.
AI_MODEL_ROUTES={"gpt-5.4-mini":"azure-openai-responses","DeepSeek-V4-Flash":"azure-openai-responses","gpt-5.6-luna":"azure-openai-responses"}

# Models offered in the chat model picker.
ALLOWED_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gpt-5.4-mini,DeepSeek-V4-Flash,gpt-5.6-luna

# Google AI Studio key. GOOGLE_API_KEY is consulted as a fallback when GEMINI_API_KEY is unset.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Azure AI Foundry. The endpoint is the RESOURCE ROOT — the client appends /openai/v1 itself, so a
# full API path copied from the Foundry portal produces a 404 that names nothing.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com
AZURE_OPENAI_API_KEY=

# Embeddings and reranking. There is no fallback; retrieval does not work without it.
VOYAGE_API_KEY=

# Optional: deployment names that address a reasoning model, where the deployment is not named
# after the model it serves. Comma-separated; blank lets the name heuristic decide.
AZURE_OPENAI_REASONING_MODELS=

# ── Retired ──────────────────────────────────────────────────────────────────────────────────
# cloudflare-gemini, openrouter and azure-openai (chat completions) are rejected by LlmConfig at
# startup. Their settings remain in application.yml so re-enabling one is a small change, but
# naming any of them in AI_PROVIDER fails the start rather than degrading it. Do not set
# CLOUDFLARE_* or OPENROUTER_*; if they are already in your .env they are inert.

# ── Tunables (all have working defaults — uncomment only to override) ────────────────────────
# GEMINI_THINKING_LEVEL=medium
# RAG_THINKING_LEVEL=medium
# KG_THINKING_LEVEL=low
# SUMMARIZE_THINKING_LEVEL=low
# AZURE_OPENAI_THINKING_LEVEL=medium
# KG_MODEL=gemini-3.1-flash-lite
# SUMMARIZE_MODEL=gemini-3.1-flash-lite
# EMBEDDING_MODEL=voyage-4-large
# RERANK_MODEL=rerank-2.5
# APP_AI_RAG_MAX_ITERATIONS=20
# APP_RATE_LIMIT_ENABLED=true
# APP_RATE_LIMIT_CAPACITY=20
# APP_RATE_LIMIT_REFILL_SECONDS=60
# APP_GENERATION_MAX_CONCURRENT=64
# APP_CHAT_COST_EXPLORER_MAX_ROWS=5000
# APP_UPLOADS_DIR=uploads
